<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <AssemblyName>LiteBrowser</AssemblyName>
    <RootNamespace>LiteBrowser</RootNamespace>
    <Product>LiteBrowser</Product>
    <Version>3.1.1</Version>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    <!-- Réglages pour consommer le moins de RAM possible côté appli -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <EmbeddedResource Include="home.html" LogicalName="home.html" />
    <EmbeddedResource Include="multi.html" LogicalName="multi.html" />
    <EmbeddedResource Include="nurbridge.js" LogicalName="nurbridge.js" />
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

</Project>
